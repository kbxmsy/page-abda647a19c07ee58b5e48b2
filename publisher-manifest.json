:var(--paper);border:2px solid var(--ink);padding:0}\ndetails summary{list-style:none;cursor:pointer;padding:14px 18px;font-weight:700;font-size:15px;display:flex;justify-content:space-between;align-items:center;gap:10px}\ndetails summary::-webkit-details-marker{display:none}\ndetails summary::after{content:\"+\";font-size:22px;color:var(--violet);font-weight:900}\ndetails[open] summary::after{content:\"−\"}\ndetails .a{padding:0 18px 16px;font-size:14px;color:var(--ink);border-top:1px dashed var(--line);padding-top:12px}\n\n/* 说明区块 */\n.notes{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}\n@media (max-width:760px){.notes{grid-template-columns:1fr}}\n.note{padding:18px;border:3px solid var(--ink);background:var(--paper)}\n.note h4{font-size:14px;margin-bottom:8px;letter-spacing:1px;text-transform:uppercase}\n.note p{font-size:13.5px;color:var(--mute)}\n\nfooter{padding:36px 0 50px;background:var(--ink);color:var(--paper);font-size:13px;margin-top:0}\nfooter .wrap{display:flex;justify-content:space-between;gap:18px;flex-wrap:wrap;align-items:flex-start}\nfooter p{max-width:46ch;opacity:.85}\n\n@media (max-width:760px){\n  .stack{flex-direction:column}\n  .left-rail{width:100%;min-height:auto;position:relative;border-right:none;border-bottom:2px solid var(--ink);padding:18px 18px 12px}\n  .rail-foot{position:static;margin-top:14px}\n  .h1{font-size:38px}\n  .band-b .h1{font-size:42px}\n  .band{padding:36px 22px}\n}\n</style><div class=\"stack\">\n<aside class=\"left-rail\">\n  <a href=\"#top\" class=\"brand-mark\">尤选 CHCC<small>Y O U X U A N · C H C C</small></a>\n  <div class=\"rail-label\">JUMP TO</div>\n  <nav class=\"rail-nav\">\n    <a href=\"#why\">为什么叫尤选</a>\n    <a href=\"#who\">谁在用它</a>\n    <a href=\"#how\">上手四步</a>\n    <a href=\"#plans\">三档月付</a>\n    <a href=\"#compare\">横向看一看</a>\n    <a href=\"#clients\">客户端兼容</a>\n    <a href=\"#faq\">常见问题</a>\n    <a href=\"#talk\">聊两句</a>\n  </nav>\n  <div class=\"rail-foot\">本站只是把身边朋友用得顺手的几个套餐罗列给大家，每一行都是真人发起的试用邀请，并不代表任何官方背景。</div>\n</aside>\n\n<main class=\"main\" id=\"top\">\n\n\n<header class=\"hero\">\n  <div class=\"band band-a\">\n    <div class=\"wrap\">\n      <span class=\"eyebrow\">朋友之间的线路推荐</span>\n      <h1 class=\"h1\">尤选(CHCC) · 把好用的线路，介绍给身边的人。<small>尤选 CHCC · 一份按月付款的家庭与小队试用清单</small></h1>\n      <p class=\"lead\">我们只是几位爱折腾网络的同事，把一年里被朋友问得最多的那几档线路整理成了这张表。没有花哨的营销话术，只有月价、年价、设备数和真实可用的节点池。</p>\n    </div>\n  </div>\n  <div class=\"band band-b\">\n    <div class=\"wrap\">\n      <h2 class=\"h1\">基础版 ¥15 · 旗舰版 ¥35 · 团队版 ¥85</h2>\n      <p class=\"lead\">三档套餐从一人独用到二十人小团队依次排开，按月付灵活，按年付可省下一顿外卖钱。</p>\n      <div class=\"band-meta\">\n        <span>月付 / 年付 自选</span>\n        <span>3 — 20 台设备</span>\n        <span>无需绑定身份</span>\n      </div>\n    </div>\n  </div>\n  <div class=\"band band-c\">\n    <div class=\"wrap\">\n      <span class=\"eyebrow\">最近一次更新</span>\n      <h3 class=\"h1\">十一月的试用报告</h3>\n      <p>本月共发出 47 份试用邀请，旗舰版的流媒体解锁是最常被称赞的一栏，团队版的 IP 干净度也值得记一笔。这份清单会随着朋友们的反馈每月微调一次。</p>\n    </div>\n  </div>\n</header>\n\n\n<section id=\"why\">\n  <div class=\"wrap\">\n    <h2 class=\"h2\">为什么叫“尤选”</h2>\n    <p class=\"lede\">一开始只是想给三五个朋友推荐稳定线路，名字就叫“小尤在用”。结果问的人越来越多，干脆起个新名字——尤选，意思是“尤其值得选的那一份”。</p>\n    <div class=\"story\">\n      <div>\n        <h3>起因</h3>\n        <p>小组里有同事每天通勤要看一档海外剧，大家轮番试了七八家服务商，要么晚高峰卡顿、要么节点失效，最终把还能用的两三家拢到了一起。</p>\n        <p>既然已经筛选过了，不如把筛选结果公开，谁需要谁自取，省得再走一遍我们走过的弯路。</p>\n      </div>\n      <div>\n        <h3>现在的样子</h3>\n        <p>页面上的三档套餐都不是临时拼凑，而是从 2024 年 3 月起就持续有人在用的版本。每月月底会汇总朋友们的吐槽，下个月顺手把不达标的节点池换掉。</p>\n        <p>我们不卖代理软件、不写评测稿，也不接软文。这一页只是把身边人觉得顺手的几档套餐摆出来。</p>\n      </div>\n    </div>\n  </div>\n</section>\n\n\n<section id=\"who\">\n  <div class=\"wrap\">\n    <h2 class=\"h2\">谁在用它</h2>\n    <p class=\"lede\">三档套餐覆盖了三种最常见的使用场景，下面是朋友们的真实用法摘选。</p>\n    <div class=\"story\">\n      <div class=\"box\">\n        <h3>一个人住的小 W</h3>\n        <p>晚上追两集美剧、白天偶尔查资料，基础版的 100GB 流量对小 W 来说刚好够一个月。三个设备位留给了手机、电脑和一台老安卓盒子。</p>\n        <p>她最在意的就是“打开就能看”，所以她的反馈永远是晚高峰有没有崩。</p>\n      </div>\n      <div class=\"box\">\n        <h3>合租的四个人</h3>\n        <p>四个室友各用一台手机一台电脑，刚好把旗舰版的五个设备位占满。其中两人打游戏，所以 IPLC 专线是这一档里最先被点开的选项。</p>\n        <p>他们之间有个不成文的规矩，谁先回去谁负责按下续费按钮。</p>\n      </div>\n    </div>\n  </div>\n</section>\n\n\n<section id=\"how\">\n  <div class=\"wrap\">\n    <h2 class=\"h2\">从朋友推荐到真正打开，一共四步</h2>\n    <p class=\"lede\">不需要开发票、不需要实名、不需要阅读长篇协议。整个流程我们在小组里走过十几遍了。</p>\n    <div class=\"steps\">\n      <div class=\"step\"><span class=\"n\">01</span><div><div class=\"t\">挑一档套餐</div><p class=\"d\">看月流量和设备数对不对得上自己的用法，拿不准就先选基础版，反正随时能升档。</p></div></div>\n      <div class=\"step\"><span class=\"n\">02</span><div><div class=\"t\">下单并付款</div><p class=\"d\">支持月付与年付，年付会显示在每张套餐卡的右侧，按一次按钮就会生成订阅链接。</p></div></div>\n      <div class=\"step\"><span class=\"n\">03</span><div><div class=\"t\">导入客户端</div><p class=\"d\">复制订阅地址到下方列表里任意一个客户端，扫码也行、粘贴也行，第一次大概两分钟。</p></div></div>\n      <div class=\"step\"><span class=\"n\">04</span><div><div class=\"t\">体验并反馈</div><p class=\"d\">用上一周，觉得合适就留下，觉得不行把意见发给共建群，下个月我们就把这一档调整得更顺手。</p></div></div>\n    </div>\n  </div>\n</section>\n\n\n<section id=\"plans\">\n  <div class=\"wrap\">\n    <h2 class=\"h2\">三档月付套餐，逐张大卡</h2>\n    <p class=\"lede\">单列大卡的好处是每一档都能完整看全：左边是谁在用、中间包含哪些权益、右边是价格。下面是从低到高的排列。</p>\n    <div class=\"plans\">\n\n      <article class=\"plan\">\n        <div class=\"who\">\n          <h3>基础版</h3>\n          <span>FOR ONE PERSON</span>\n        </div>\n        <div class=\"body\">\n          <p>适合一人独居、追剧为主、顺带查资料的轻度用户。每月 100GB 极速流量，三台设备同时在线。</p>\n          <ul>\n            <li>每月 100GB 极速流量</li>\n            <li>支持 3 台设备同时在线</li>\n            <li>解锁基础流媒体</li>\n            <li>普通线路节点池</li>\n          </ul>\n        </div>\n        <div class=\"price\">\n          <span class=\"tag\">入门款</span>\n          <div class=\"now\">¥15<span>/月</span></div>\n          <div class=\"yr\">按年付仅需 ¥150/年</div>\n        </div>\n      </article>\n\n      <article class=\"plan featured\">\n        <div class=\"who\">\n          <h3>旗舰版</h3>\n          <span>FOR ROOMMATES</span>\n        </div>\n        <div class=\"body\">\n          <p>合租、夫妻档、偶尔想打打海外服的玩家都会选这一档。原生流媒体解锁与 IPLC 专线游戏加速是它的两大亮点，也是被推荐最多的一档。</p>\n          <ul>\n            <li>每月 300GB 极速流量</li>\n            <li>支持 5 台设备同时在线</li>\n            <li>全节点原生流媒体解锁</li>\n            <li>IPLC 专线游戏加速优化</li>\n            <li>7×24 优先工单支持</li>\n          </ul>\n        </div>\n        <div class=\"price\">\n          <span class=\"tag\">推荐档</span>\n          <div class=\"now\">¥35<span>/月</span></div>\n          <div class=\"yr\">按年付仅需 ¥350/年</div>\n        </div>\n      </article>\n\n      <article class=\"plan\">\n        <div class=\"who\">\n          <h3>团队版</h3>\n          <span>FOR SMALL STUDIO</span>\n        </div>\n        <div class=\"body\">\n          <p>小工作室、远程协作小队、自媒体小组都从这一档起步。VIP 专属节点与企业定制路由让二十人同时在线也不会互相挤占。</p>\n          <ul>\n            <li>每月 1000GB 极速流量</li>\n            <li>支持 20 台设备同时在线</li>\n            <li>VIP 专属高带宽节点</li>\n            <li>支持企业定制路由</li>\n            <li>专属客户经理服务</li>\n          </ul>\n        </div>\n        <div class=\"price\">\n          <span class=\"tag\">多人协作</span>\n          <div class=\"now\">¥85<span>/月</span></div>\n          <div class=\"yr\">按年付仅需 ¥850/年</div>\n        </div>\n      </article>\n\n    </div>\n  </div>\n</section>\n\n\n<section id=\"compare\">\n  <div class=\"wrap\">\n    <h2 class=\"h2\">横向看一眼差异</h2>\n    <p class=\"lede\">如果你还在犹豫，把三档的关键数字并排在一起会清楚很多。</p>\n    <div class=\"story\">\n      <div class=\"box\">\n        <h3>流量与设备</h3>\n        <p>基础版每月 100GB、3 台设备；旗舰版每月 300GB、5 台设备；团队版每月 1000GB、20 台设备。流量超出后，三档都会被临时降到普通线路，下个月初自动恢复。</p>\n      </div>\n      <div class=\"box\">\n        <h3>专属与解锁</h3>\n        <p>流媒体解锁与 IPLC 专线游戏加速从旗舰版开始提供；VIP 专属节点、企业定制路由、专属客户经理仅出现在团队版，适合有定制需求的小组织。</p>\n      </div>\n    </div>\n  </div>\n</section>\n\n\n<section id=\"clients\">\n  <div class=\"wrap\">\n    <h2 class=\"h2\">常见客户端都能用</h2>\n    <p class=\"lede\">我们测试的是订阅链接的兼容性，下面这些客户端都能顺利导入。选一个你已经在用的就行。</p>\n    <div class=\"notes\">\n      <div class=\"note\"><h4>桌面端</h4><p>Windows、macOS、Linux 系统上常见的代理客户端基本都支持，复制订阅链接导入即可。需要下载安装包请前往客户端官方网站，未提供可靠地址时不随意附上链接。</p></div>\n      <div class=\"note\"><h4>移动端</h4><p>iOS 与 Android 上常用的几款代理客户端都可以导入订阅，部分客户端需要先开启读取剪贴板的权限。如果是国行系统，可能需要额外的描述文件步骤。</p></div>\n      <div class=\"note\"><h4>路由器与盒子</h4><p>支持 OpenWrt、固件类的路由器，以及常见的安卓电视盒子。家中设备多、想一次配置全家设备时，这一项特别省事。</p></div>\n    </div>\n  </div>\n</section>\n\n\n<section id=\"faq\">\n  <div class=\"wrap\">\n    <h2 class=\"h2\">关于尤选 CHCC 的常见问题</h2>\n    <p class=\"lede\">下面这些是被朋友们问得最多的几件事，挑了七个回答。点击展开看完整内容。</p>\n    <div class=\"faqs\">\n      <details>\n        <summary>尤选 CHCC 到底是做什么的？</summary>\n        <div class=\"a\">尤选 CHCC 是一个朋友之间互相推荐线路的小型介绍站。我们不运营底层节点池，只是把身边人觉得顺手、稳定、价格合理的几档套餐整理在一张表里，方便大家按月或按年选用。</div>\n      </details>\n      <details>\n        <summary>三档套餐分别适合谁？</summary>\n        <div class=\"a\">基础版适合单人轻度使用，100GB 流量与 3 台设备已经够一人独居的小 W 追完全月想看的剧。旗舰版是合租、夫妻档、四人小队的首选，5 台设备与 IPLC 专线留出了协作余量。团队版面向 5 到 20 人的小工作室或自媒体小组，1000GB 流量与专属节点避免互相挤占。</div>\n      </details>\n      <details>\n        <summary>可以月付也可以年付吗？</summary>\n        <div class=\"a\">可以。三档都同时提供月付与年付两种方式，月付灵活退订、年付更划算。选择年付后一次性付清，下一年到期前会提前三周在站内提醒续费，不会出现“自动扣款忘了关”的尴尬。</div>\n      </details>\n      <details>\n        <summary>流量用完会怎么样？</summary>\n        <div class=\"a\">当月流量用完后，三档套餐都会被临时切换到普通线路节点池，网速会有明显下降，但不会断网也不会产生额外费用。下个月初流量会自动恢复成极速档。</div>\n      </details>\n      <details>\n        <summary>要不要实名、要不要开发票？</summary>\n        <div class=\"a\">不需要实名认证，也暂时无法开具发票。尤选本身只是朋友间的介绍站，下单与售后由对应的运营方负责。如果你需要发票报销，建议直接在团队版里联系专属客户经理协商。</div>\n      </details>\n      <details>\n        <summary>支持哪些客户端？</summary>\n        <div class=\"a\">只要客户端支持标准订阅链接导入，理论上都能用。常见桌面端、移动端、路由器固件与安卓电视盒子我们都测试过。如遇导入问题，可以在共建群里贴出客户端版本号与报错截图，我们会协助排查。</div>\n      </details>\n      <details>\n        <summary>觉得不合适可以退吗？</summary>\n        <div class=\"a\">月付套餐在 7 天内可以无理由退订；年付套餐在 30 天内若流量未超过 50GB 也可以申请退订，按剩余天数比例退款。具体退订入口在每份订阅邮件的底部都会有说明。</div>\n      </details>\n    </div>\n  </div>\n</section>\n\n\n<section id=\"talk\">\n  <div class=\"wrap\">\n    <h2 class=\"h2\">聊两句</h2>\n    <p class=\"lede\">如果你试用过某一档套餐、或者只是想问一个不在 FAQ 里的问题，都欢迎通过下面的方式找到我们。</p>\n    <div class=\"story\">\n      <div class=\"box\">\n        <h3>共建群</h3>\n        <p>邀请身边朋友一起试用时建立的微信群，平时聊天内容以线路心得、节点稳定性吐槽、客户端配置互助为主。进群链接请向已经试用过的朋友索取，不对外公开。</p>\n      </div>\n      <div class=\"box\">\n        <h3>意见与反馈</h3>\n        <p>套餐价格、节点池分布、客户端兼容、退订流程——任何你觉得不顺手的细节都可以告诉我们。我们承诺每月把反馈汇总，下月初一次性在站内公开调整。</p>\n      </div>\n    </div>\n  </div>\n</section>\n\n<footer>\n  <div class=\"wrap\">\n    <p>尤选 CHCC · 一份朋友之间的线路推荐清单。本站为非营利介绍页，所列套餐由对应运营方提供，账单、退订、发票与售后请联系对应运营方处理。</p>\n    <p>© 尤选 CHCC</p>\n  </div>\n</footer>\n\n</main>\n</div>",
